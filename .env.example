# Sao chép thành .env trước khi triển khai ngoài máy cá nhân.
# Sinh chuỗi bí mật dài, ngẫu nhiên; không commit file .env.
SESSION_SECRET=thay-bang-chuoi-bi-mat-dai-va-ngau-nhien

# false cho localhost HTTP; true khi nginx được đặt sau HTTPS.
COOKIE_SECURE=false

# Thông tin PostgreSQL: dùng giá trị mạnh và riêng cho máy chủ thật.
POSTGRES_DB=sdt
POSTGRES_USER=sdt
POSTGRES_PASSWORD=thay-mat-khau-postgresql-dai-va-ngau-nhien

# Chỉ đổi nếu cổng 8080 đang được dịch vụ khác sử dụng.
WEB_PORT=8080
API_PORT=4000
